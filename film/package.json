{
  "name": "livelings-launch",
  "private": true,
  "type": "module",
  "scripts": {
    "serve": "node tools/serve.mjs",
    "stems": "python3 tools/stems.py",
    "capture": "node tools/capture.mjs",
    "studio": "remotion studio src/index.ts",
    "render:short-zh": "remotion render src/index.ts Short-zh renders/livelings-short-zh-raw.mp4 --crf=12 --concurrency=4",
    "render:short-en": "remotion render src/index.ts Short-en renders/livelings-short-en-raw.mp4 --crf=12 --concurrency=4",
    "render:long-zh": "remotion render src/index.ts Long-zh renders/livelings-long-zh-raw.mp4 --crf=12 --concurrency=4",
    "finish": "bash tools/finish.sh"
  },
  "dependencies": {
    "@remotion/cli": "4.0.380",
    "@remotion/google-fonts": "4.0.380",
    "playwright-core": "1.56.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.380"
  },
  "devDependencies": {
    "@remotion/bundler": "^4.0.380",
    "@remotion/renderer": "^4.0.380",
    "@types/react": "19.1.0",
    "typescript": "5.9.3"
  }
}
